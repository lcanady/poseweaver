# Environment Variables Template for PoseWeaver Frontend
# Copy this file to .env.local for local development
# Configure these variables in DigitalOcean App Platform for production

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:5001

# Google OAuth Configuration
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id-here

# Production Settings (automatically set by DigitalOcean App Platform)
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
PORT=3000
HOSTNAME=0.0.0.0
