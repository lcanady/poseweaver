# Production Environment Variables for PoseWeaver
# Copy this file to .env and fill in your actual values

# Database
MONGO_PASSWORD=your_secure_mongo_password_here

# Frontend URL (where your app will be accessible)
FRONTEND_URL=https://your-domain.com
NEXT_PUBLIC_API_URL=https://your-domain.com

# Backend Environment Variables (copy to backend/.env)
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=your_super_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here

# MongoDB Connection
MONGODB_URI=mongodb://admin:your_secure_mongo_password_here@mongodb:27017/poseweaver?authSource=admin

# Venice AI
VENICE_API_KEY=your_venice_api_key_here
VENICE_TIMEOUT=60

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Google OAuth (if using)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Application Settings
PORT=5000
