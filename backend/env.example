# OpenRouter Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True

# Application Configuration
SECRET_KEY=your_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here

# MongoDB Configuration
MONGODB_URI=mongodb://admin:password@localhost:27017/mush_pose_editor?authSource=admin
MONGODB_DB=mush_pose_editor

# Legacy Database Configuration (SQLAlchemy - deprecated)
# DATABASE_URL=sqlite:///mush_pose_editor.db
# SQLALCHEMY_TRACK_MODIFICATIONS=False

# Model Configuration
DEFAULT_MODEL=google/gemini-2.0-flash-001
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=1000 
