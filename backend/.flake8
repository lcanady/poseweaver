[flake8]
max-line-length = 79
exclude = 
    .git,
    __pycache__,
    .pytest_cache,
    .coverage,
    htmlcov,
    dist,
    build,
    *.egg-info,
    .venv,
    venv
ignore = 
    E203,  # whitespace before ':'
    W503,  # line break before binary operator
    F401,  # imported but unused (handled by other tools)
per-file-ignores = 
    __init__.py:F401
max-complexity = 10
docstring-convention = google 