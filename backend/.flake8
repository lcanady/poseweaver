[flake8]
max-line-length = 79
exclude = 
    .git,
    __pycache__,
    .pytest_cache,
    .coverage,
    htmlcov,
    dist,
    build,
    *.egg-info,
    .venv,
    venv
ignore = 
    E203,
    W503,
    F401
per-file-ignores = 
    __init__.py:F401
max-complexity = 10
docstring-convention = google 