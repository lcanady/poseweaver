# OpenRouter AI Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_TIMEOUT=60

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True

# Frontend Configuration
FRONTEND_URL=https://www.poseweaver.com

# Application Configuration
SECRET_KEY=your_secret_key_here

# AI Provider Configuration (OpenRouter Free Tier)
AI_API_KEY=sk-or-your-api-key-here
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=cognitivecomputations/dolphin-mistral-24b-venice-edition:free
APP_URL=http://localhost:3000
APP_NAME=PoseWeaver

# Model Configuration
# DEFAULT_MODEL=dolphin-2.9-llama3-70b (Deprecated, using AI_MODEL)
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=1000

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Database Configuration
# Set DB_TYPE to 'firebase' to use Firestore (recommended)
# Set DB_TYPE to 'mongodb' to use MongoDB
DB_TYPE=firebase

# Firebase Configuration (required if DB_TYPE=firebase)
FIREBASE_CREDENTIALS_PATH=/path/to/serviceAccountKey.json
# Alternatively, use GOOGLE_APPLICATION_CREDENTIALS env var

# MongoDB Configuration (only needed if DB_TYPE=mongodb)
MONGODB_URI=mongodb://admin:password@localhost:27017/mush_pose_editor?authSource=admin
MONGODB_DB=mush_pose_editor

# Redis Configuration
REDIS_URL=redis://localhost:6379 