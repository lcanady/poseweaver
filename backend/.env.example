# Venice AI Configuration
VENICE_API_KEY=b6An7ME8Pt7vjf8oFmKyCMf0bF-ChrczwLhkSiAFZh
VENICE_TIMEOUT=120

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True

# Frontend Configuration
FRONTEND_URL=https://www.poseweaver.com

# Application Configuration
SECRET_KEY=your_secret_key_here

# Model Configuration
DEFAULT_MODEL=dolphin-2.9-llama3-70b
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=1000

# MongoDB Configuration
# Option 1: Local MongoDB (requires MongoDB installed)
# MONGODB_URI=mongodb://localhost:27017/poseweaver

# Option 2: MongoDB Atlas (cloud) - recommended for production
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/poseweaver?retryWrites=true&w=majority

# Option 3: For development without MongoDB (uses in-memory storage)
MONGODB_URI=
MONGODB_DB=poseweaver

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here 